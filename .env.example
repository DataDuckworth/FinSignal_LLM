# Copy this file to ".env" (same folder) and fill in your own values. ".env" is git-ignored; this template is not.
# One KEY=value per line, no spaces around "=". Quotes are optional. Lines starting with # are comments.

# Groq API key, from the API Keys page of your Groq console (usually starts with gsk_)
GROQ_API_KEY=

# Optional: which Groq model to use. Leave commented to use the default set in src/llm_extract.py
# GROQ_MODEL=openai/gpt-oss-20b
